# --- GitHub -----------------------------------------------------------------
# No client id, no secret, no token. Auth is delegated to the `gh` CLI:
#   gh auth login --scopes "repo,read:org"
# This app shells out to `gh api`, so it never sees a GitHub credential.
#
# Optional: restrict the repo picker AND branch creation to your corp org(s).
GITHUB_ORGS=
# Optional: GitHub Enterprise Server host (leave empty for github.com).
GH_HOST=

# --- Jira (OAuth 2.0 3LO + PKCE) --------------------------------------------
# Create an app: https://developer.atlassian.com/console/myapps/
#   Permissions: Jira API -> read:jira-work, write:jira-work, read:jira-user
#   Callback URL: http://127.0.0.1:4178/api/auth/jira/callback
JIRA_CLIENT_ID=
# Atlassian still requires a secret for confidential clients. PKCE is always
# sent. This is read from env at boot only: never written to disk by this app,
# never sent to the browser, never logged.
JIRA_CLIENT_SECRET=

# --- Local service ----------------------------------------------------------
PORT=4178
BRANCH_TEMPLATE={type}/{key}-{slug}
