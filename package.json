{
  "name": "jira-branch-forge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-only service: pick a Jira card, pick a corp GitHub repo, create the branch.",
  "scripts": {
    "start": "bash run.sh",
    "dev": "bash run.sh dev",
    "check": "bash run.sh check",
    "serve": "node server/index.js",
    "dev:all": "concurrently -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch server/index.js",
    "dev:web": "vite --config web/vite.config.js",
    "build": "vite build --config web/vite.config.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/static": "^10.1.3",
    "better-sqlite3": "^11.8.1",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.11"
  }
}
